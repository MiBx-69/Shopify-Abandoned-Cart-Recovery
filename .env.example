# --- Shopify app credentials (from Partners dashboard / shopify.app.toml) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-domain.example.com
SCOPES=read_checkouts,read_orders,read_customers

# --- Database (Postgres or MySQL) ---
# Postgres example:
DATABASE_URL=postgresql://user:password@localhost:5432/abandoned_checkouts
# MySQL example (also change `provider` in prisma/schema.prisma to "mysql"):
# DATABASE_URL=mysql://user:password@localhost:3306/abandoned_checkouts

# --- Alpha SMS ---
ALPHA_SMS_BASE_URL=https://api.sms.net.bd/sendsms
ALPHA_SMS_API_KEY=your_alpha_sms_api_key
ALPHA_SMS_SENDER_ID=

# --- Custom recovery email (SMTP) ---
# Shopify's built-in abandoned-checkout email is automatic and enabled in
# Settings > Checkout — it doesn't need config here. These vars are only
# for the *custom* email this app sends on its own schedule.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Store <no-reply@yourstore.com>"

# --- Timing ---
SMS_DELAY_MINUTES=30
EMAIL_DELAY_MINUTES=1440
MAX_ABANDONED_AGE_HOURS=72
SHOP_DISPLAY_NAME=Your Store Name

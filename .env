# --- Shopify app credentials ---
SHOPIFY_API_KEY=test_api_key
SHOPIFY_API_SECRET=test_api_secret
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_checkouts,read_orders,read_customers

# --- Database (SQLite for local testing) ---
DATABASE_URL="file:./dev.db"

# --- Alpha SMS (Leave empty or set to test for console simulation mode) ---
ALPHA_SMS_BASE_URL=https://api.sms.net.bd/sendsms
ALPHA_SMS_API_KEY=
ALPHA_SMS_SENDER_ID=

# --- Custom recovery email (SMTP - Leave empty for console simulation mode) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Store <no-reply@yourstore.com>"

# --- Timing (shortened for testing) ---
SMS_DELAY_MINUTES=0
EMAIL_DELAY_MINUTES=0
MAX_ABANDONED_AGE_HOURS=72
SHOP_DISPLAY_NAME="My Test Shopify Store"
